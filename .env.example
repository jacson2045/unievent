# Copia este archivo como .env y completa los valores antes de `docker compose up`.
# .env está en .gitignore: los secretos nunca se suben al repositorio.

# PostgreSQL (una base de datos por microservicio, mismo usuario/clave en desarrollo)
POSTGRES_USER=unievent
POSTGRES_PASSWORD=cambia-esta-clave

# Firma de los JWT (HS512): mínimo 64 caracteres. Debe ser la misma para todos los servicios.
# Puedes generar una con:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Administrador inicial (admin@upeu.edu.pe). Se crea solo si aún no existe ningún ADMIN.
# Mínimo 8 caracteres. Si se deja vacío, no se crea el administrador.
ADMIN_PASSWORD=

# Mercado Pago (credenciales de PRUEBA del panel de desarrolladores). Sin ellas el sistema
# funciona, pero no se pueden pagar eventos con costo.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# URL pública del frontend (Mercado Pago devuelve al estudiante aquí después de pagar)
FRONTEND_URL=http://localhost:8443

# Contraseña del usuario "admin" de Grafana
GRAFANA_ADMIN_PASSWORD=admin123
